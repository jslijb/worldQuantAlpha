# ============================================================
# WorldQuant BRAIN 项目 .gitignore
# 规范源见根目录 CLAUDE.md「版本控制」一节
# ============================================================

# ---------- 凭据（红线：绝不入库，一旦提交极难彻底清除） ----------
brain_credentials.txt
*.credentials
*.credential
*_token.txt
*_secret.txt
.env
.env.*

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/

# ---------- 运行日志（时效性内容，无历史追溯价值） ----------
*.log

# ---------- 运行产物目录 _autologs/（探索性脚本 / 一次性统计 / 候选缓存） ----------
# 流水线活跃读写的暂存区（search_combos_*.json、*.txt、*.log、工具脚本都在这里），
# 定位为"运行产物"，不进版本历史。需长期保留的工具脚本先搬进 src/ 再忽略。
_autologs/

# 但 _autologs/sim_run.py 是**发模拟的唯一通道**（所有批次都从这儿过），
# 2026-11-16 起纳入版本控制：门控逻辑改动必须留 diff。
!_autologs/sim_run.py

# ---------- _grid/ 的数据缓存与一次性产物（保留核心门控代码的版本化） ----------
# 2026-11-16 修正：此前 _grid/ 整体未被跟踪，导致核心门控代码
# （op_ban / diversity / depth_check / batch_gen / transforms / atom_complex / corr_gate）
# 的任何改动都没有 diff、没有回滚、没有历史 —— 这正是"改了但没人看得见"的结构性成因。
# 现在：门控代码显式纳入版本控制（见下方 ! 规则），只忽略缓存与大体积产物。
_grid/*
!_grid/*.py
!_grid/exp_deep_vs_shallow_1116.json
!_grid/markets.json

# ---------- 工具缓存 / IDE ----------
.codegraph/
.codeartsdoer/
.arts/
.freebuff/
.idea/
.vscode/
*.swp

# ---------- WorkBuddy 工作区目录 ----------
# 只保留 memory（项目知识资产，需版本化）；
# 其余（自动任务运行态、缓存）属本地状态，会制造提交噪声。
.workbuddy/*
!.workbuddy/memory/

# ---------- 临时文件 ----------
*.tmp
*.bak
*~
Thumbs.db
desktop.ini


# 论文 PDF / 抓取正文 / 索引：版权件与会话产物，只留本机，绝不进公开仓库
docs/papers/
.chrome-papers-profile/
